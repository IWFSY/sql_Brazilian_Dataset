		    #"Повышенные заголовки" = Table.PromoteHeaders(#"Измененный тип", [PromoteAllScalars=true]),
		    #"Измененный тип1" = Table.TransformColumnTypes(#"Повышенные заголовки",{{"product_category_name", type text}, {"product_category_name_english", type text}}),
		    #"Замененное значение" = Table.ReplaceValue(#"Измененный тип1","_"," ",Replacer.ReplaceText,{"product_category_name"}),
