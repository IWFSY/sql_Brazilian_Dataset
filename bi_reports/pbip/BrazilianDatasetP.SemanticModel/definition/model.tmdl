model Model
	culture: ru-RU
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: ru-RU
	valueFilterBehavior: independent
	dataAccessOptions
		fastCombine
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 1_Import

	annotation PBI_QueryGroupOrder = 0

queryGroup 2_Dimentions

	annotation PBI_QueryGroupOrder = 1

queryGroup 3_Facts

	annotation PBI_QueryGroupOrder = 2

queryGroup 4_Other

	annotation PBI_QueryGroupOrder = 3

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["gold dim_products_mart","gold dim_customers_mart","gold dim_sellers_mart","gold fact_mart","product_category_name_translation","dim_products_mart","dim_payment_type","dim_order_status","fact_order_items","dim_customers_mart","dim_sellers_mart","fact_order_payments","security","unique_state","_measures","confirmed_dim"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_products_mart
ref table dim_payment_type
ref table dim_order_status
ref table fact_order_items
ref table dim_customers_mart
ref table dim_sellers_mart
ref table dim_date
ref table fact_order_payments
ref table security
ref table _measures
ref table confirmed_dim

ref role 'Regional Acess'

ref cultureInfo ru-RU

