table _measures
	lineageTag: e395089b-70de-4411-8fed-8e5d8656ed10

	measure 'Заказов доставлено' = ```
			
			CALCULATE(
			    DISTINCTCOUNT(fact_order_items[ID заказа]),
			    fact_order_items[order_status_key] = 1, 
			    USERELATIONSHIP(dim_date[Дата], fact_order_items[Дата вручения заказа]))
			```
		formatString: 0
		displayFolder: 2. Заказы
		lineageTag: aec790a7-1822-4e43-8607-d956125283a3

	measure 'Заказов оформлено' =
			
			CALCULATE(
			    DISTINCTCOUNT(fact_order_items[ID заказа]),
			    USERELATIONSHIP(dim_date[Дата], fact_order_items[Дата создания заказа]))
		formatString: #,0
		displayFolder: 2. Заказы
		lineageTag: f9c0ba23-9359-4593-8f50-c5db6505db20

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Затраты на доставку' =
			
			CALCULATE(
			    SUM(fact_order_items[Стоимость доставки]),
			    USERELATIONSHIP(dim_date[Дата], fact_order_items[Планируемая дата доставки]))
		displayFolder: 3. Логистика
		lineageTag: fb0a49e1-cdd6-4526-8ad8-944609098c70

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Выручка за заказы, которые были подтверждены и оплачены. Скрыл потому что в контексте текущего датасета не имеет смысла, но тем не менее, имеет смысл в контексте бизнеса в целом
	measure 'Выручка по проведенным платежам' =
			
			CALCULATE(
			    SUM(fact_order_payments[Полная сумма заказа]),
			    USERELATIONSHIP(dim_date[Дата], fact_order_payments[Дата подтверждения заказа])
			)
		isHidden
		displayFolder: 1. Коммерция
		lineageTag: 3cfa1813-67cc-4641-aa7f-73c3708d2a10

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Средние дни доставки курьером' =
			
			CALCULATE(
			    AVERAGEX(
			        FILTER(fact_order_items, NOT(ISBLANK(fact_order_items[Дата вручения заказа]))),
			        DATEDIFF(fact_order_items[Дата передачи в службу доставки], fact_order_items[Дата вручения заказа], DAY)),
			    USERELATIONSHIP(dim_date[Дата], fact_order_items[Дата вручения заказа]))
		displayFolder: 3. Логистика
		lineageTag: 09843a10-3b28-4bfa-8056-b6171e58a5db

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Средние дни сборки продавцом' = ```
			
			AVERAGEX(
			    FILTER(
			        fact_order_items, 
			        NOT(ISBLANK(fact_order_items[Дата передачи в службу доставки])) && 
			        NOT(ISBLANK(fact_order_items[Дата создания заказа]))),
			    DATEDIFF(fact_order_items[Дата создания заказа], fact_order_items[Дата передачи в службу доставки], DAY))
			```
		displayFolder: 3. Логистика
		lineageTag: 7d10e140-2318-4143-a55f-3abfe4b54eca

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Поскольку в текущем датасете все заказы считаются проведенными, то достаточно только общей выручки по всем заказам. Выручка по проведенным скрыта.
	measure 'Выручка по заказам' =
			
			CALCULATE(
			    SUM(fact_order_payments[Полная сумма заказа]),
			    USERELATIONSHIP(dim_date[Дата], fact_order_payments[Дата создания заказа]))
		formatString: R$ #,0
		displayFolder: 1. Коммерция
		lineageTag: 9db33070-de6c-49b2-b90a-cc291d0d691f

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Доля логистики в выручке' = DIVIDE(SUM(fact_order_items[Стоимость доставки]), SUM(fact_order_items[Стоимость товара]))
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 3. Логистика
		lineageTag: afdfb3f6-3baf-4b92-bd70-6008aad14a31

	measure 'Количество продавцов' = DISTINCTCOUNT(fact_order_items[seller_key])
		formatString: 0
		displayFolder: 4. Клиенты и Продавцы
		lineageTag: ffc16a33-03cf-4fd7-9439-64593a0b8262

	measure 'Продано уникальных товаров' = DISTINCTCOUNT(fact_order_items[product_key])
		formatString: 0
		displayFolder: 2. Заказы
		lineageTag: e9e18b17-b6e4-41f1-b7bd-4933ba79579b

	measure 'Продано товаров' = COUNT(fact_order_items[Порядковый номер товара в заказе])
		formatString: 0
		displayFolder: 2. Заказы
		lineageTag: 25985147-53cb-4742-8700-8a7c55572e24

	measure 'Количество клиентов (по заказам)' =
			
			CALCULATE(
			    DISTINCTCOUNT(fact_order_items[customer_key]),
			    USERELATIONSHIP(dim_date[Дата], fact_order_items[Дата создания заказа]))
		formatString: 0
		displayFolder: 4. Клиенты и Продавцы
		lineageTag: b93627ac-326f-4300-9cef-8238973fc44a

	measure 'Количество уникальных клиентов' =
			
			CALCULATE(
			    DISTINCTCOUNT(dim_customers_mart[Уникальный ID клиента]),
			    CROSSFILTER(fact_order_items[customer_key], dim_customers_mart[customer_key], BOTH),
			    USERELATIONSHIP(dim_date[Дата], fact_order_items[Дата создания заказа]))
		formatString: #,0
		displayFolder: 4. Клиенты и Продавцы
		lineageTag: f6b59e28-372a-4933-8767-cb4810a10f12

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Количество бесплатных доставок' =
			
			CALCULATE(
			    COUNT(fact_order_items[Порядковый номер товара в заказе]), fact_order_items[Бесплатная доставка] = "Да",
			    USERELATIONSHIP(dim_date[Дата], fact_order_items[Дата создания заказа]))
		formatString: 0
		displayFolder: 3. Логистика
		lineageTag: 5fae40ea-037b-474f-ac44-973c9ae500b9

	measure 'Доля бесплатных заказов' = ```
			
			DIVIDE(
			    [Количество бесплатных доставок], 
			    [Заказов оформлено])
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 3. Логистика
		lineageTag: 5dd0e993-80f4-400b-afa3-f1feb13abe78

	measure 'Процент отмененных заказов' =
			
			DIVIDE([Заказов отменено], [Заказов оформлено]) + 0
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 2. Заказы
		lineageTag: 1f980729-2094-48a7-b55b-d7815ecdc504

	measure 'Заказов отменено' =
			
			CALCULATE(
			    DISTINCTCOUNT(fact_order_items[ID заказа]),
			    fact_order_items[order_status_key] = 2,
			    USERELATIONSHIP(dim_date[Дата], fact_order_items[Дата создания заказа]))
		formatString: 0
		displayFolder: 2. Заказы
		lineageTag: b1b09a40-75b9-469b-8c1f-8544221c260b

	measure 'Среднее число заказов на клиента' = ```
			
			VAR UniqueCustomers = 
			    CALCULATE(
			        DISTINCTCOUNT(dim_customers_mart[Уникальный ID клиента]),
			        CROSSFILTER(fact_order_items[customer_key], dim_customers_mart[customer_key], BOTH),
			        USERELATIONSHIP(dim_date[Дата], fact_order_items[Дата создания заказа]))
			RETURN
			DIVIDE([Заказов оформлено], UniqueCustomers)
			```
		displayFolder: 4. Клиенты и Продавцы
		lineageTag: beaf0268-ce14-4949-90c7-edc77e56bde6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Выручка на клиента (ARPU)' = ```
			
			VAR UniqueCustomers = 
			    CALCULATE(
			        DISTINCTCOUNT(dim_customers_mart[Уникальный ID клиента]),
			        CROSSFILTER(fact_order_items[customer_key], dim_customers_mart[customer_key], BOTH),
			        USERELATIONSHIP(dim_date[Дата], fact_order_items[Дата создания заказа]))
			RETURN
			DIVIDE([Выручка по заказам], UniqueCustomers)
			```
		formatString: R$ #,0
		displayFolder: 1. Коммерция
		lineageTag: 97bced84-61f7-414b-8a7b-8ca70bc49509

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Средний чек заказа (AOV)' = ```
			DIVIDE([Выручка по заказам], [Заказов оформлено])
			
			```
		formatString: " R$ #,0"
		displayFolder: 1. Коммерция
		lineageTag: ad3b5b00-1dcb-430b-862a-8467bfaa6598

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Количество товаров в чеке (UPT)' = DIVIDE([Продано товаров], [Заказов оформлено])
		displayFolder: 2. Заказы
		lineageTag: e12378fb-45d5-43ae-bd99-c7f893203cbd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Доля просроченных доставок (SLA)' =
			
			CALCULATE(
			    DIVIDE(
			        COUNTROWS(FILTER(fact_order_items, fact_order_items[Нарушение Дедлайна] = "Да")), [Заказов доставлено]),
			    USERELATIONSHIP(dim_date[Дата], fact_order_items[Дата вручения заказа]))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 3. Логистика
		lineageTag: ad7bdbd2-c92e-459e-bf67-9c1ff7956a91

	measure 'Средняя стоимость доставки' = DIVIDE([Затраты на доставку], [Заказов оформлено])
		displayFolder: 3. Логистика
		lineageTag: a3114aa2-8d7a-486a-ab61-59ea0ab6ade0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Выручка прошлого года' = ```
			
			CALCULATE(
			    [Выручка по заказам], 
			    SAMEPERIODLASTYEAR(dim_date[Дата])
			)
			```
		isHidden
		displayFolder: 1. Коммерция
		lineageTag: c78b06fe-48ae-4123-8f7a-18cff7d87889

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'YoY Выручка' =
			
			VAR _Current = [Выручка по заказам]
			VAR _Previous = [Выручка прошлого года]
			RETURN
			    DIVIDE(_Current - _Previous, _Previous)
		formatString: 0.00%;-0.00%;0.00%
		isHidden
		displayFolder: 1. Коммерция
		lineageTag: b1baf19f-3b45-4b6a-93b9-2bad39e1daad

		changedProperty = IsHidden

